# Copy to .env and fill in what you have. Nothing here is required to run
# the app at Tier A (keyless) capability.

APP_ENV=dev
DATA_DIR=./backend/.data
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# --- LLM (Phase 04) ---
# Provider ids for LLM_*_PROVIDER / LLM_FAILOVER:
#   anthropic | google (AI Studio / Gemini) | openai (ChatGPT) | xai (Grok)
#   thaillm | ollama (local) | ollama_cloud | deepseek | groq | openrouter | claude_code
# Aliases also accepted: claude, gemini, aistudio, chatgpt, grok, claude_sub.
ANTHROPIC_API_KEY=
# (P16) provider claude_code = Claude through YOUR OWN Claude subscription, by running the
# Claude Code CLI installed on this machine (claude -p). PERSONAL USE ONLY, on your own machine:
# this token is not an API key and must never be used to serve other users (Claude Code legal &
# compliance); a deployment for others needs provider anthropic + their own ANTHROPIC_API_KEY.
# Token from `claude setup-token` (sk-ant-oat01-...); CLAUDE_CODE_OAUTH_TOKEN also works. Leave
# empty to use the login Claude Code already has on this machine.
ANTHROPIC_API_SUB_KEY=
# Path to the claude CLI when it is not on PATH (e.g. C:\Users\me\AppData\Roaming\npm\claude.cmd)
CLAUDE_CODE_BIN=
# How many claude processes may run at once
CLAUDE_CODE_MAX_CONCURRENCY=2
# Per-call timeout for claude_code (replaces LLM_TIMEOUT_S for this provider only)
CLAUDE_CODE_TIMEOUT_S=300
# Microcompact count trigger when the agent runs on claude_code; empty = off (token trigger only)
CLAUDE_CODE_MC_COUNT_TRIGGER=
# Google AI Studio key (https://aistudio.google.com/apikey); GEMINI_API_KEY also works
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# ThaiLLM (OpenAI-compatible, free): key from playground.thaillm.or.th.
# Models (all support tool calls): OpenThaiGPT-ThaiLLM-8B-Instruct-v7.2,
#   Typhoon-S-ThaiLLM-8B-Instruct, Pathumma-ThaiLLM-qwen3-8b-think-3.0.0, THaLLE-0.2-ThaiLLM-8B-fa
# Rate limit 5 req/s, 200 req/min. THAILLM_BASE_URL only to override https://thaillm.or.th/api/v1
THAILLM_API_KEY=
THAILLM_BASE_URL=
# Ollama local server, e.g. http://localhost:11434 (no key; /v1 is appended automatically)
OLLAMA_BASE_URL=
# Ollama Cloud (provider id ollama_cloud, https://ollama.com/v1): key from ollama.com/settings/keys.
# Models: gpt-oss:120b (recommended), gpt-oss:20b, gemma4:31b
OLLAMA_API_KEY=
DEEPSEEK_API_KEY=
# Groq (OpenAI-compatible, free tier): key from console.groq.com/keys.
# Recommended model openai/gpt-oss-120b; limits per model at console.groq.com/settings/limits
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Leave both unset to auto-pick: the first configured provider above, in
# order anthropic > google > openai > groq > thaillm > ollama_cloud > ollama > deepseek > xai >
# openrouter, with its recommended model (Typhoon-S-ThaiLLM-8B-Instruct for
# thaillm — free and the most reliable of the 4 free models at tool calls).
# Setting one of PROVIDER/MODEL requires setting the other.
LLM_DEEP_PROVIDER=
LLM_DEEP_MODEL=
LLM_QUICK_PROVIDER=
LLM_QUICK_MODEL=
# low | medium | high | xhigh | max (optional)
LLM_DEEP_EFFORT=
LLM_QUICK_EFFORT=
# Tried in order when the primary fails, e.g. google:gemini-2.5-pro,openai:gpt-5,ollama:qwen3:8b
LLM_FAILOVER=
# Optional per-tier override of LLM_FAILOVER
# LLM_DEEP_FAILOVER=
# LLM_QUICK_FAILOVER=
LLM_TIMEOUT_S=120
# USD per 1M tokens for models not in the built-in catalog: model=in/out[/cache_read],...
LLM_PRICING=

# --- Run guards (Phase 05) ---
RUN_MAX_ITERATIONS=10
RUN_MAX_TOOL_CALLS_TOTAL=40
RUN_TOOL_TIMEOUT_S=30
RUN_WALL_CLOCK_S=600
RUN_MAX_COST_USD=1.0
RUN_MAX_OUTPUT_TOKENS_TOTAL=200000

# --- Long-term memory + ReasoningBank + 5 Whys (Phase 17) ---
# false = no recall/learn/5 Whys (graph nodes stay, no extra LLM calls)
MEMORY_ENABLED=true
# token budget of the INVESTOR PROFILE block injected into prompts
MEMORY_PROFILE_MAX_TOKENS=600
# k-anonymity gate: a lesson becomes active once this many runs/users produced it (3 when multi-user)
REASONING_BANK_MIN_SOURCES=1
# max "why" questions per goal before answering without asking
DISCOVERY_MAX_WHYS=5
# below this goal-understanding confidence a buy/sell request gets a closing why-question
DISCOVERY_CONFIDENCE=0.7

# --- Data providers: Tier A (keyless) ---
SEC_EDGAR_USER_AGENT="FinanceHarness your-email@example.com"

# --- Data providers: Tier B (free keys) ---
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# --- Data providers: Tier C (paid / optional) ---
FINANCIAL_DATASETS_API_KEY=
X_BEARER_TOKEN=
ADANOS_API_KEY=
EXASEARCH_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
LANGSEARCH_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEC_API_KEY=
TYPESAFE_API_KEY=
