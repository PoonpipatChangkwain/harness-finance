# Copy to .env and fill in what you have. Nothing here is required to run
# the app at Tier A (keyless) capability.

APP_ENV=dev
DATA_DIR=./backend/.data
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# --- LLM (Phase 04) ---
# Provider ids for LLM_*_PROVIDER / LLM_FAILOVER:
#   anthropic | google (AI Studio / Gemini) | openai (ChatGPT) | xai (Grok)
#   thaillm | ollama (local) | ollama_cloud | deepseek | groq | openrouter
# Aliases also accepted: claude, gemini, aistudio, chatgpt, grok.
ANTHROPIC_API_KEY=
# Google AI Studio key (https://aistudio.google.com/apikey); GEMINI_API_KEY also works
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# ThaiLLM (OpenAI-compatible, free): key from playground.thaillm.or.th.
# Models (all support tool calls): OpenThaiGPT-ThaiLLM-8B-Instruct-v7.2,
#   Typhoon-S-ThaiLLM-8B-Instruct, Pathumma-ThaiLLM-qwen3-8b-think-3.0.0, THaLLE-0.2-ThaiLLM-8B-fa
# Rate limit 5 req/s, 200 req/min. THAILLM_BASE_URL only to override https://thaillm.or.th/api/v1
THAILLM_API_KEY=
THAILLM_BASE_URL=
# Ollama local server, e.g. http://localhost:11434 (no key; /v1 is appended automatically)
OLLAMA_BASE_URL=
# Ollama Cloud (provider id ollama_cloud, https://ollama.com/v1): key from ollama.com/settings/keys.
# Models: gpt-oss:120b (recommended), gpt-oss:20b, gemma4:31b
OLLAMA_API_KEY=
DEEPSEEK_API_KEY=
# Groq (OpenAI-compatible, free tier): key from console.groq.com/keys.
# Recommended model openai/gpt-oss-120b; limits per model at console.groq.com/settings/limits
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Leave both unset to auto-pick: the first configured provider above, in
# order anthropic > google > openai > groq > thaillm > ollama_cloud > ollama > deepseek > xai >
# openrouter, with its recommended model (Typhoon-S-ThaiLLM-8B-Instruct for
# thaillm — free and the most reliable of the 4 free models at tool calls).
# Setting one of PROVIDER/MODEL requires setting the other.
LLM_DEEP_PROVIDER=
LLM_DEEP_MODEL=
LLM_QUICK_PROVIDER=
LLM_QUICK_MODEL=
# low | medium | high | xhigh | max (optional)
LLM_DEEP_EFFORT=
LLM_QUICK_EFFORT=
# Tried in order when the primary fails, e.g. google:gemini-2.5-pro,openai:gpt-5,ollama:qwen3:8b
LLM_FAILOVER=
# Optional per-tier override of LLM_FAILOVER
# LLM_DEEP_FAILOVER=
# LLM_QUICK_FAILOVER=
LLM_TIMEOUT_S=120
# USD per 1M tokens for models not in the built-in catalog: model=in/out[/cache_read],...
LLM_PRICING=

# --- Run guards (Phase 05) ---
RUN_MAX_ITERATIONS=10
RUN_MAX_TOOL_CALLS_TOTAL=40
RUN_TOOL_TIMEOUT_S=30
RUN_WALL_CLOCK_S=600
RUN_MAX_COST_USD=1.0
RUN_MAX_OUTPUT_TOKENS_TOTAL=200000

# --- Data providers: Tier A (keyless) ---
SEC_EDGAR_USER_AGENT="FinanceHarness your-email@example.com"

# --- Data providers: Tier B (free keys) ---
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# --- Data providers: Tier C (paid / optional) ---
FINANCIAL_DATASETS_API_KEY=
X_BEARER_TOKEN=
ADANOS_API_KEY=
EXASEARCH_API_KEY=
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
LANGSEARCH_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEC_API_KEY=
TYPESAFE_API_KEY=
